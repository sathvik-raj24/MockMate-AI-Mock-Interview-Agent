# Copy this file to .env and fill in your key.  NEVER commit .env.

# Which provider to talk to. "nvidia" is the default (free tier on build.nvidia.com).
# Other LangChain providers work too (openai, anthropic, google_genai, ...) if you
# `uv add` their langchain-<provider> package and set <PROVIDER>_API_KEY.
# "fake" runs a scripted offline model (no key needed) for tests and demos.
MODEL_PROVIDER=nvidia

# Model id as shown in the NVIDIA catalogue (https://build.nvidia.com/models).
# Catalogue entries change over time; if you get a "model not found" error, copy a
# current chat model id from that page.
MODEL_NAME=nvidia/nemotron-3.5-lightning-30b-a3b

# Key for the provider above: <PROVIDER>_API_KEY  (or the generic MODEL_API_KEY)
NVIDIA_API_KEY=nvapi-your-key-here

# Optional
QUESTIONS_PER_SESSION=5
